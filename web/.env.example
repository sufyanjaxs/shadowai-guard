# Copy to web/.env.local and fill in real values
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Absolute origin of this deployment. Invite links are built from it and are
# never taken from a request header. Leave blank to fall back to VERCEL_URL.
APP_URL=https://app.yourcompany.com

# How this deployment charges: "manual" (invoice / bank transfer, activated with
# `node scripts/set-plan.mjs`) or "stripe" (card checkout). Defaults to "manual"
# unless Stripe is fully configured, because Stripe is not available in every
# country — notably Pakistan.
BILLING_PROVIDER=manual

# Stripe — only needed when BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring prices. Only these two ids are accepted by /api/checkout.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_BUSINESS=price_...

# Optional: transactional invite email (Resend). Without it the dashboard shows
# the invite link for you to send manually.
RESEND_API_KEY=re_...
INVITE_EMAIL_FROM=ShadowAI Guard <noreply@yourcompany.com>

# The real address customers use to reach you. Shown on the Billing page and on the
# public privacy policy, which both web stores require to be genuine. No placeholder
# fallback: an unconfigured deployment omits the contact rather than printing a dead
# address that a customer will actually try to email.
NEXT_PUBLIC_SUPPORT_EMAIL=you@yourdomain.com

# Email verification on new accounts. OFF unless this is set to exactly "required".
#
# Leave it off until a real SMTP provider is configured on the Supabase project.
# Supabase's built-in mailer only delivers to the project's own team members, so
# requiring confirmation without a provider does not verify anyone - it strands
# every signup behind an email that is never sent. See DEPLOY.md section 3.
EMAIL_VERIFICATION=required