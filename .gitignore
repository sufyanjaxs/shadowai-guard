# Environment variables (never commit these — they hold credentials)
.env
.env.*
!.env.example
extension/.env
extension/.env.local
web/.env.local

# Dependencies and build output
node_modules
dist
.next
out
*.tsbuildinfo

# Supabase CLI's downloaded binaries and generated local secrets
.tools/
supabase/.temp/

# E2E browser profile (keeps the loaded-extension state between runs)
extension/e2e/.profile

# Deployment / tooling
.vercel
*.log
coverage
.DS_Store
Thumbs.db

# Store submission artefacts. Rebuild with `node extension/scripts/package-store.mjs`.
# The listing copy is tracked; the zip and the screenshots are generated binaries.
extension/release/*.zip
extension/release/screenshots/